<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Etichette #<%= order.id %> - MotoStaffa Spedizioni</title>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: 'Arial', sans-serif; 
      background: #f0f0f0; 
      padding: 20px;
    }
    .labels-wrapper {
      max-width: 800px;
      margin: 0 auto;
    }
    .labels-row {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .label {
      background: white;
      border: 2px solid #333;
      border-radius: 12px;
      padding: 24px;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .label-type {
      font-size: 11px;
      text-transform: uppercase;
      color: #fff;
      letter-spacing: 1px;
      margin-bottom: 16px;
      padding: 6px 12px;
      border-radius: 6px;
      display: inline-block;
      font-weight: bold;
    }
    .label-type.dest {
      background: #2563eb;
    }
    .label-type.mitt {
      background: #dc2626;
    }
    .recipient-name {
      font-size: 22px;
      font-weight: bold;
      color: #000;
      margin-bottom: 12px;
      text-transform: uppercase;
      line-height: 1.3;
    }
    .recipient-address {
      font-size: 16px;
      color: #333;
      line-height: 1.5;
      margin-bottom: 4px;
    }
    .recipient-zip-city {
      font-size: 16px;
      font-weight: 600;
      color: #000;
      margin-top: 8px;
    }
    .recipient-province {
      font-size: 16px;
      font-weight: 600;
      color: #000;
      margin-top: 4px;
    }
    .print-btn {
      display: block;
      width: 100%;
      max-width: 780px;
      margin: 20px auto;
      padding: 16px;
      background: #f97316;
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    .print-btn:hover {
      background: #ea580c;
    }
    .copy-section {
      max-width: 780px;
      margin: 20px auto;
      background: white;
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .copy-section h3 {
      font-size: 14px;
      margin-bottom: 12px;
      color: #333;
    }
    .copy-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .copy-box {
      background: #f8f8f8;
      padding: 12px;
      border-radius: 8px;
    }
    .copy-box h4 {
      font-size: 12px;
      color: #666;
      margin-bottom: 8px;
      text-transform: uppercase;
    }
    .copy-box textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-family: 'Courier New', monospace;
      font-size: 12px;
      resize: vertical;
      min-height: 80px;
      background: white;
    }
    .copy-btn {
      margin-top: 8px;
      padding: 8px 12px;
      background: #333;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      transition: background 0.2s;
    }
    .copy-btn:hover {
      background: #555;
    }
    @media print {
      body { background: white; padding: 0; margin: 0; }
      .no-print { display: none !important; }
      .labels-wrapper { max-width: 100%; }
      .labels-row { 
        display: flex; 
        gap: 10mm;
        justify-content: center;
        flex-wrap: nowrap;
      }
      .label { 
        border: 1px solid #000; 
        border-radius: 0;
        box-shadow: none;
        width: 90mm;
        max-width: 90mm;
        padding: 15px;
        page-break-inside: avoid;
      }
      @page { 
        size: A4; 
        margin: 10mm;
      }
    }
    @media (max-width: 768px) {
      .labels-row {
        flex-direction: column;
        align-items: center;
      }
      .copy-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <button class="print-btn no-print" onclick="window.print()">🖨️ Stampa Etichette</button>

  <div class="labels-wrapper">
    <div class="labels-row">
      <!-- Etichetta Destinatario -->
      <div class="label">
        <div class="label-type dest">DESTINATARIO</div>
        <div class="recipient-name"><%= order.customer_name %></div>
        <div class="recipient-address"><%= order.customer_address %></div>
        <div class="recipient-zip-city"><%= order.customer_zip %> <%= order.customer_city %></div>
        <% if (order.customer_province) { %>
          <div class="recipient-province">(<%= order.customer_province.toUpperCase() %>)</div>
        <% } %>
      </div>

      <!-- Etichetta Mittente -->
      <div class="label">
        <div class="label-type mitt">MITTENTE</div>
        <div class="recipient-name">Mauro Masucci</div>
        <div class="recipient-address">Via Strada di Spina, 2</div>
        <div class="recipient-zip-city">20054 Segrate (MI)</div>
      </div>
    </div>
  </div>

  <div class="copy-section no-print">
    <h3>📋 Copia Indirizzi</h3>
    <div class="copy-grid">
      <div class="copy-box">
        <h4>Destinatario</h4>
        <textarea id="destText" readonly>Dest: <%= order.customer_name %>
<%= order.customer_address %>
<%= order.customer_zip %> <%= order.customer_city %><% if (order.customer_province) { %> (<%= order.customer_province.toUpperCase() %>)<% } %></textarea>
        <button class="copy-btn" onclick="copyToClipboard('destText')">Copia Destinatario</button>
      </div>
      <div class="copy-box">
        <h4>Mittente</h4>
        <textarea id="mittText" readonly>Mitt: Mauro Masucci
Via Strada di Spina, 2
20054 Segrate (MI)</textarea>
        <button class="copy-btn" onclick="copyToClipboard('mittText')">Copia Mittente</button>
      </div>
    </div>
  </div>

  <script>
    function copyToClipboard(elementId) {
      const textarea = document.getElementById(elementId);
      textarea.select();
      textarea.setSelectionRange(0, 99999);
      try {
        document.execCommand('copy');
        const btn = event.target;
        const originalText = btn.textContent;
        btn.textContent = '✓ Copiato!';
        btn.style.background = '#22c55e';
        setTimeout(() => {
          btn.textContent = originalText;
          btn.style.background = '#333';
        }, 2000);
      } catch (err) {
        console.error('Errore copia: ', err);
        alert('Premi Ctrl+C per copiare');
      }
    }
  </script>
</body>
</html>